# Grafana stack (created 2026-08-23)
GRAFANA_URL=https://dreamystairs2355.grafana.net
GRAFANA_STACK_ID=1805312
# Service account token, role Admin (stack UI: Administration > Users and access > Service accounts)
GRAFANA_SA_TOKEN=
# Access policy token with metrics:write + logs:write (portal: Security > Access Policies)
GRAFANA_CLOUD_TOKEN=
# Public dashboard share URLs the console embeds. Defaults are pinned in
# config.py; set these only if the stack was reprovisioned and the access
# tokens changed (scripts/provision_grafana.py prints the current pair).
GRAFANA_PUBLIC_OVERVIEW=
GRAFANA_PUBLIC_TIMELINE=
# Metrics land in Mimir via the OTLP gateway (basic auth: STACK_ID:CLOUD_TOKEN)
OTLP_URL=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# Logs push (basic auth: LOKI_USER:CLOUD_TOKEN)
LOKI_PUSH_URL=https://logs-prod-012.grafana.net/loki/api/v1/push
LOKI_USER=1763099

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1

# Vertex model ids (pinned via scripts/probe_models.py; re-run it per project,
# Model Garden availability differs by GCP project and region)
GEMINI_MODEL_VISION=gemini-3.7-flash
GEMINI_MODEL_TEXT=gemini-3.7-flash
IMAGEN_MODEL=gemini-3.1-flash-image
# NOTE: a model appearing in models.list() does not mean the project can
# generate with it. On veoapi-469317, veo-3.0-* and veo-2.0-* list fine but
# 404 on predictLongRunning; only veo-3.1-* actually generates. Verify with
# a real generate_videos call, not with a listing.
VEO_MODEL=veo-3.1-generate-001
TTS_MODEL=gemini-2.5-flash-tts
