# Grafana stack (created 2026-08-23)
GRAFANA_URL=https://dreamystairs2355.grafana.net
# Service account token, role Admin. Stack UI: Administration > Users and access
# > Service accounts > Add service account > Add token
GRAFANA_SA_TOKEN=

# Metrics + logs push. Grafana Cloud portal (grafana.com > your stack):
# open "Details" on Prometheus and on Loki, copy endpoint + username (numeric
# instance id), then create ONE access policy token with metrics:write + logs:write
# (portal: Security > Access Policies)
PROM_PUSH_URL=
PROM_USER=
LOKI_PUSH_URL=
LOKI_USER=
GRAFANA_CLOUD_TOKEN=

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
