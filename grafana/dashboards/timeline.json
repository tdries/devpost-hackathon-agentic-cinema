{
  "uid": "customs-timeline",
  "title": "Customs: Timeline",
  "description": "The centrepiece. A commercial is a time series and the timecode is the x-axis: video second n is written at wall clock t0 + n, so a panel pinned to [t0, t0 + duration] reads as the ad's own timecode.",
  "tags": [
    "customs"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Customs findings",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "type": "dashboard",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "customs"
          ],
          "limit": 100
        }
      },
      {
        "name": "Resolved by remediation",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "type": "dashboard",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "customs",
            "resolved"
          ],
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "asset",
        "label": "Asset",
        "description": "Which asset (the video file stem) this page is about",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(customs_risk, asset)",
          "refId": "VariableQuery-asset"
        },
        "definition": "label_values(customs_risk, asset)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Risk by market across the timecode",
      "description": "customs_risk, one row per market. Colour is the worst severity covering that second: green clear, yellow noted, orange serious, red at or over the blocking threshold of 70. last_over_time over the panel step keeps a second honest: without it Prometheus staleness would carry a dimension's last severity forward for five minutes and paint clean seconds red.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (market) (last_over_time(customs_risk{asset=~\"$asset\"}[$__interval]))",
          "legendFormat": "{{market}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "interval": "1s"
        }
      ],
      "maxDataPoints": 600,
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none",
          "hideZeros": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#34A853",
                "value": null
              },
              {
                "color": "#FBBC05",
                "value": 40
              },
              {
                "color": "#FBBC05",
                "value": 60
              },
              {
                "color": "#EA4335",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Risk by observation dimension",
      "description": "The same seconds, grouped by what the Analyst was looking at rather than by market. Rows with dimension none are the clean seconds and are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (dimension) (last_over_time(customs_risk{asset=~\"$asset\", dimension!=\"none\"}[$__interval]))",
          "legendFormat": "{{dimension}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "interval": "1s"
        }
      ],
      "maxDataPoints": 600,
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none",
          "hideZeros": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#34A853",
                "value": null
              },
              {
                "color": "#FBBC05",
                "value": 40
              },
              {
                "color": "#FBBC05",
                "value": 60
              },
              {
                "color": "#EA4335",
                "value": 70
              }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "The same risk, second by second",
      "description": "The same query drawn as lines, where the exact severity at each second is readable rather than implied by a colour band. Findings show on both panels as red annotation regions, and remediations as green ones, at the timecode they belong to.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (market) (last_over_time(customs_risk{asset=~\"$asset\"}[$__interval]))",
          "legendFormat": "{{market}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "interval": "1s"
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#4285F4"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#34A853",
                "value": null
              },
              {
                "color": "#FBBC05",
                "value": 40
              },
              {
                "color": "#FBBC05",
                "value": 60
              },
              {
                "color": "#EA4335",
                "value": 70
              }
            ]
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "maxDataPoints": 600
    },
    {
      "id": 4,
      "type": "text",
      "title": "Reading this page",
      "description": "",
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "Each row is a market, each column a second of the ad. Click a cell and drill into the finding on the Findings page, or open the market on the Market Detail page.\n\nThe red annotation markers are findings, written by the pipeline as Grafana annotations at the exact moment in the ad they refer to. Green markers are remediations that resolved one."
      }
    }
  ]
}
