          "qryType": 1,
          "query": "label_values(customs_market_status, asset)",
          "refId": "VariableQuery-asset"
        },
        "definition": "label_values(customs_market_status, asset)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "market",
        "label": "Market",
        "description": "Market code, for example FR, SA or US",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(customs_market_status, market)",
          "refId": "VariableQuery-market"
        },
        "definition": "label_values(customs_market_status, market)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": false,
        "allValue": null,
