{
  "uid": "customs-findings",
  "title": "Customs: Findings",
  "description": "Every finding the adjudicators wrote, as raw log lines and as a table. The line body is the finding JSON, so rule, class, severity, citation and the sourced flag are all queryable without a join back to the run store.",
  "tags": [
    "customs"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "name": "Customs findings",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "type": "dashboard",
        "target": {
          "type": "tags",
          "matchAny": false,
          "tags": [
            "customs"
          ],
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "asset",
        "label": "Asset",
        "description": "Which asset (the video file stem) this page is about",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "grafanacloud-logs"
        },
        "query": {
          "qryType": 1,
          "query": "label_values({app=\"customs\", kind!=\"observation\", kind!=\"observation\"}, asset)",
          "refId": "VariableQuery-asset"
        },
        "definition": "label_values({app=\"customs\", kind!=\"observation\", kind!=\"observation\"}, asset)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Finding stream",
      "description": "Raw Loki lines, newest first. Expand a line to see the whole finding including its rationale and citation URL.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{app=\"customs\", kind!=\"observation\", asset=~\"$asset\"}",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": false
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Findings",
      "description": "The same lines parsed. sourced=false means the adjudicator could not ground the finding in a citation, which the guard treats as advisory rather than blocking.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{app=\"customs\", kind!=\"observation\", asset=~\"$asset\"} | json severity=\"severity\", sourced=\"sourced\", citation=\"citation_ref\", rationale=\"rationale\", status=\"status\", t_start=\"t_start\"",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 500
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "replace": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "severity",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "market",
                "rule_id",
                "severity",
                "sourced",
                "citation",
                "rationale"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Time": 0,
              "market": 1,
              "rule_id": 2,
              "severity": 3,
              "sourced": 4,
              "citation": 5,
              "rationale": 6
            },
            "renameByName": {
              "rule_id": "rule"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": "",
          "enablePagination": false
        },
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "inspect": false,
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#34A853",
                      "value": null
                    },
                    {
                      "color": "#FBBC05",
                      "value": 40
                    },
                    {
                      "color": "#FBBC05",
                      "value": 60
                    },
                    {
                      "color": "#EA4335",
                      "value": 70
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    }
  ]
}
